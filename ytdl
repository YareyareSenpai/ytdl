#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat << 'HELP'
ytdl - yt-dlp wrapper with fzf format picker

Usage:
  ytdl <URL>              Download a single track (fzf format picker)
  ytdl <URL> -p           Download entire playlist
  ytdl <URL> --playlist   Download entire playlist (long form)
  ytdl --help             Show this help

Format selection:
  [DEFAULT] m4a is pre-selected — just hit Enter to grab best native m4a
  Scroll the list to pick any other format (opus, webm, etc.)
  In playlist mode, if a track lacks your chosen format it falls back to best m4a

Output:
  Single:   ~/Music/<uploader> - <title>.m4a
  Playlist: ~/Music/<playlist>/<index> - <uploader> - <title>.m4a
HELP
}

if [[ $# -lt 1 ]] || [[ "$1" == "--help" ]] || [[ "$1" == "-h" ]]; then
    usage
    exit 0
fi

URL="$1"
MUSIC_DIR=~/Music
PLAYLIST_MODE=false

for arg in "$@"; do
    case $arg in
        -p|--playlist) PLAYLIST_MODE=true ;;
    esac
done

echo "Fetching available formats..."

FORMAT_LIST=$(yt-dlp -F "$URL" 2>/dev/null | grep -E '^[0-9]+')

M4A_DEFAULT="[DEFAULT] m4a  │  ba[ext=m4a]/ba[acodec^=mp4a]/ba  │  best available m4a, no transcode"

CHOSEN=$(printf '%s\n%s' "$M4A_DEFAULT" "$FORMAT_LIST" \
    | fzf \
        --prompt="Format > " \
        --header="↑↓ select format  |  Enter to download  |  ESC to cancel" \
        --layout=reverse \
        --border=rounded \
        --height=60% \
        --highlight-line)

if [[ -z "$CHOSEN" ]]; then
    echo "Cancelled."
    exit 0
fi

if $PLAYLIST_MODE; then
    OUTPUT="$MUSIC_DIR/%(playlist_title)s/%(playlist_index)s - %(uploader)s - %(title)s.%(ext)s"
else
    OUTPUT="$MUSIC_DIR/%(uploader)s - %(title)s.%(ext)s"
fi

if [[ "$CHOSEN" == "$M4A_DEFAULT" ]]; then
    FORMAT='-f ba[ext=m4a]/ba[acodec^=mp4a]/ba'
else
    FORMAT_CODE=$(echo "$CHOSEN" | awk '{print $1}')
    FORMAT="-f $FORMAT_CODE/ba[ext=m4a]/ba[acodec^=mp4a]/ba"
fi

echo "Downloading${PLAYLIST_MODE:+ playlist}..."

yt-dlp \
    $FORMAT \
    --remux-video m4a \
    --embed-metadata \
    --embed-thumbnail \
    --ignore-errors \
    -o "$OUTPUT" \
    ${PLAYLIST_MODE:+--yes-playlist} \
    ${PLAYLIST_MODE:+--sleep-interval 1} \
    "$URL"
